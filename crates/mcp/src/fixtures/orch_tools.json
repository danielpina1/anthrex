{
  "_about": "Milestone 9 brief, Interfaces \"MCP (crates/mcp)\": every tool of the orchestrator and the sub-planner, and the worker's task_note, as the table gives them. Built from the table alone, independently of the Rust schemas it checks. Milestone 9.3 decision 29 (task M9.3.7) adds edit_plan's iterate (string, 1 to 16,384 characters) and the orchestrator's seventh tool, start_goal, from that decision's text; edit_plan requires nothing, since the daemon reads a missing edits as an empty batch (task M9.3.7's fix round 1).",
  "orchestrator": [
    {
      "name": "get_context",
      "description": "Read the run's context: the repository profile, the models you can route to, the limits, scout reports, epics and the plan so far.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scouts": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          }
        },
        "required": []
      }
    },
    {
      "name": "spawn_scout",
      "description": "Start a read-only scout on one area with one question. Returns at once; its report appears in run_status and get_context.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "area": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "web": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "question",
          "area"
        ]
      }
    },
    {
      "name": "spawn_subplanner",
      "description": "Start a sub-planner for one epic with its own area, or a fresh one to re-plan an existing epic. Returns at once.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "epic": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,10}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "area": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "scout_refs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          }
        },
        "required": [
          "epic",
          "title",
          "area",
          "brief"
        ]
      }
    },
